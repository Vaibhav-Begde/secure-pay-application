# =============================================================
# SecurePay — Environment Variable Template
# Copy to .env and fill in real values before production deploy.
# NEVER commit .env to version control.
# =============================================================

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/securepay_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=securepay_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Email (SMTP) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# --- JWT ---
# Generate a secure 256-bit Base64 key, e.g.:
#   openssl rand -base64 32
APP_JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_SECRET
APP_JWT_EXPIRATION_MS=86400000

# --- App ---
APP_MAIL_ENABLED=true
